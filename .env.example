# Copy this file to .env for local testing; never commit the real .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the Supabase secret key. Legacy service_role key is accepted as fallback.
SUPABASE_SECRET_KEY=
# Optional legacy key name:
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_DIMENSIONS=768

# Service-account JSON, minified or multiline. Keep only in environment variables.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The folder ID of the private BILLI_R20 database folder in Google Drive.
BILLI_DRIVE_FOLDER_ID=

# Generate a long random value. Required to protect private chat/search/sync endpoints.
BILLI_ADMIN_TOKEN=
BILLI_MAX_DRIVE_FILE_MB=10
BILLI_DRIVE_PAGE_SIZE=100
